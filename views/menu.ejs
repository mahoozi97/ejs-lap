<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>menu</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <h1>Full Menu</h1>
    <ul>
      <% RESTAURANT.menu.forEach(function(item) { %> 
      <% let star = item.rating === 5 ? " ⭐️" : ""%>
      <li><h3><%= item.name + star %></h3></li>
      <p>Price: $<%= item.price %></p>
      <p>Raiting: <%= item.rating %></p>
      <p>Details: <%= item.details %></p>
      <% }); %>
    </ul>
  </body>
</html>
